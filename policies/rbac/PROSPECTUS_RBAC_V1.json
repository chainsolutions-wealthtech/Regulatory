    ],
    "COMPLIANCE": [
      "PROJECT_LIST", "PROJECT_READ", "ANSWER_READ", "EVIDENCE_READ", "EVIDENCE_VERIFY",
      "GENERATION_READ", "REVIEW_REQUEST", "REVIEW_ASSIGN", "REVIEW_COMMENT",
      "REVIEW_DECIDE_COMPLIANCE", "WORKFLOW_TRANSITION", "VERSION_FREEZE", "CLAUSE_READ"
    ],
    "LEGAL": [
      "PROJECT_LIST", "PROJECT_READ", "ANSWER_READ", "EVIDENCE_READ", "GENERATION_READ",
      "REVIEW_COMMENT", "REVIEW_DECIDE_LEGAL", "WORKFLOW_TRANSITION", "VERSION_FREEZE",
      "CLAUSE_READ", "CLAUSE_DRAFT", "CLAUSE_APPROVE"
    ],
    "TAX": [
      "PROJECT_LIST", "PROJECT_READ", "ANSWER_READ", "EVIDENCE_READ", "GENERATION_READ",
      "REVIEW_COMMENT", "REVIEW_DECIDE_TAX", "WORKFLOW_TRANSITION", "CLAUSE_READ"
    ],
    "OPERATIONS": [
      "PROJECT_LIST", "PROJECT_READ", "ANSWER_READ", "EVIDENCE_READ", "GENERATION_READ",
      "REVIEW_COMMENT", "REVIEW_DECIDE_OPERATIONS", "WORKFLOW_TRANSITION", "CLAUSE_READ"
    ],
    "SECURITY": [
      "PROJECT_LIST", "PROJECT_READ", "EVIDENCE_READ", "REVIEW_COMMENT",
