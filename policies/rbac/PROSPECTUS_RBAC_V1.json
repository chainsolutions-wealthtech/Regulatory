  "separationOfDuties": [
    {
      "id": "CLAUSE_AUTHOR_CANNOT_SOLE_APPROVE",
      "description": "L'auteur d'une version de clause ne peut pas être son seul approbateur.",
      "actions": ["CLAUSE_DRAFT", "CLAUSE_APPROVE"]
    },
    {
      "id": "PRODUCT_CANNOT_SELF_APPROVE_COMPLIANCE",
      "description": "Le contributeur produit ne peut pas rendre la décision conformité pour son propre travail.",
      "actions": ["ANSWER_WRITE", "REVIEW_DECIDE_COMPLIANCE"]
    },
    {
      "id": "SUBMISSION_DISABLED_V1",
      "description": "Aucun rôle ne dispose d'une autorisation de soumission dans la baseline V1.",
      "actions": ["SUBMISSION_MARK_READY", "SUBMISSION_SEND"]
    }
  ]
