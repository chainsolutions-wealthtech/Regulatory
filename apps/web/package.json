    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
