{
  "schemaVersion": 1,
  "kind": "mcp-governed-deployment-target",
  "status": "REQUESTED_NOT_PROVISIONED",
  "source": {
    "repository": "chainsolutions-wealthtech/Regulatory",
    "branch": "main"
  },
  "orchestrator": {
    "repository": "Patricked-code/MCP",
    "mode": "server-native-ssh-bridge",
    "endpoint": "https://mcp.wealthtechinnovations.com/mcp",
    "authorization": "server-side-governed-admission-required"
  },
  "destination": {
    "server": "s1",
    "pleskSubscription": "wealthtechinnovations.com",
    "host": "regulatory.wealthtechinnovations.com",
    "urlPath": "/",
    "url": "https://regulatory.wealthtechinnovations.com/",
    "documentRoot": "UNRESOLVED_REQUIRE_PLESK_PREFLIGHT",
    "applicationDirectory": "UNRESOLVED_REQUIRE_SERVER_PREFLIGHT",
    "subdomain": {
      "parentDomain": "wealthtechinnovations.com",
      "label": "regulatory",
      "fqdn": "regulatory.wealthtechinnovations.com",
      "pleskDocumentRoot": "/regulatory",
      "provisioningServer": "s1"
    }
  },
  "application": {
    "type": "nextjs",
    "workspace": "apps/web",
    "nodeMajorMinimum": 22,
    "basePath": "/",
    "buildCommand": "npm run check:web",
    "startCommand": "npm run web:start",
    "basePathMode": "root-on-dedicated-subdomain"
  },
  "safety": {
    "allowAutomaticProvisioning": false,
    "requireServerSideAllowlist": true,
    "requireFreshPreflight": true,
    "requireGovernedClaimAndLock": true,
    "requireExactCommitSha": true,
    "requireHealthAndRollback": true,
    "forbidSecretsInRepository": true,
    "forbidOtherVhostChanges": true
  },
  "tracking": {
    "mcpIssue": "https://github.com/Patricked-code/MCP/issues/349",
    "note": "Primary target is dedicated subdomain. Legacy /regulatory path is optional and not authorized for automatic rewrite. Declarative request only; no provisioning or deployment implied."
  }
}
